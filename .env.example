# --- NokaTV — Configuration ---

# Domaine public du site (OBLIGATOIRE en production).
# Ancre les canonicals, les URLs Open Graph et le sitemap.
# Sans cette valeur, ils sont déduits des en-têtes de proxy (X-Forwarded-*),
# ce qui peut produire des URLs internes http://localhost:8001 dans Google.
SITE_URL=https://nokatv.xyz

# Email de contact affiché sur /contact et /mentions-legales
# (retraits/ayants droit, liens morts)
CONTACT_EMAIL=contact@nokatv.xyz

# Origine locale de l'application
BASE_URL=http://localhost:8001

# Sources distantes agrégées
COFLIX_SOURCE_URL=https://coflix.wiki
VOIRDRAMA_SOURCE_URL=https://voirdrama.to
VOIRANIME_SOURCE_URL=https://voir-anime.to

# Profondeur de collecte du sitemap par catégorie (pages de liste scannées,
# défaut 5 — ~300 à 600 fiches exposées à Google selon les sources)
# SITEMAP_MAX_PAGES=5

# --- Publication Telegram quotidienne ---
# Le worker publie uniquement des affiches, métadonnées et liens vers les
# fiches NokaTV. Ne l'activez que pour les contenus que vous êtes autorisé à
# promouvoir. Le token ne doit jamais être commité ou partagé dans un chat.
TELEGRAM_PUBLISH_ENABLED=false
TELEGRAM_BOT_TOKEN=
# @nom_du_canal ou identifiant numérique -100… ; le bot doit pouvoir publier.
TELEGRAM_CHANNEL_FILMS=
TELEGRAM_CHANNEL_SERIES=
TELEGRAM_CHANNEL_ANIMES=
# Alias accepté si votre canal d'animés est nommé « manga » :
# TELEGRAM_CHANNEL_MANGA=
TELEGRAM_CHANNEL_ANIMATION=
# Déclenchement du service Docker (ou cron équivalent) à 12:00 dans ce fuseau
# (Cotonou / WAT, UTC+1).
TELEGRAM_TIMEZONE=Africa/Lagos
TELEGRAM_PUBLISH_HOUR=12
# Trois essais immédiats, puis SQLite réessaie automatiquement avec backoff :
# les posts Telegram et une collecte ayant échoué sont repris par --flush-retries.
TELEGRAM_REQUEST_RETRIES=3
TELEGRAM_RETRY_BASE_SECONDS=2
TELEGRAM_LEASE_SECONDS=900
# « hybrid » (défaut) relit cache.db et les seules listes récentes, adapté à
# un cron PlanetHoster. « complete » parcourt toutes les pages catalogue.
TELEGRAM_DISCOVERY_MODE=hybrid
